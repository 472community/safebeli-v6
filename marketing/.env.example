# 로컬 테스트용. 실제 값은 GitHub repo secrets 에 넣고, 이 파일은 커밋하지 않는다.
# 복사: cp marketing/.env.example marketing/.env

# 이미지 호스팅 베이스 URL (인스타 발행 시 필요. 공개 접근 가능해야 함)
MARKETING_MEDIA_BASE_URL=

# 텔레그램 신규 유입에게 자동 발송할 환영 메시지 (비우면 발송 안 함)
TELEGRAM_WELCOME_MESSAGE=

# --- 텔레그램 ---
# 유입 링크 방식: channel(기본, 채널 직결) 또는 bot(봇 경유, 글 단위 추적)
TELEGRAM_LINK_MODE=channel
# 채널 주소. 비우면 brand.json 의 telegram.channelUrl 을 쓴다
TELEGRAM_CHANNEL_URL=

# 아래는 봇을 쓸 때만 필요하다 (@BotFather 에서 발급)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=@your_channel

# --- 스레드 (Meta 앱 > Threads API) ---
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# --- 인스타그램 (Meta 앱 > Instagram Graph API, 프로페셔널 계정 필요) ---
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- 틱톡 (TikTok for Developers > Content Posting API) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
# 앱 심사 전에는 비워두세요 (비공개 게시만 가능). 심사 통과 후 PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY_LEVEL=

# --- 유튜브 (Google Cloud > YouTube Data API v3, OAuth) ---
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
