# 로컬 테스트용. 실제 값은 GitHub repo secrets 에 넣고, 이 파일은 커밋하지 않는다.
# 복사: cp marketing/.env.example marketing/.env

# 이미지 호스팅 베이스 URL (인스타 발행 시 필요. 공개 접근 가능해야 함)
MARKETING_MEDIA_BASE_URL=

# 텔레그램 신규 유입에게 자동 발송할 환영 메시지 (비우면 발송 안 함)
TELEGRAM_WELCOME_MESSAGE=

# --- 텔레그램 (봇 @BotFather 에서 발급) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@your_channel
TELEGRAM_BOT_USERNAME=your_bot
TELEGRAM_CHANNEL_URL=https://t.me/your_channel

# --- 스레드 (Meta 앱 > Threads API) ---
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# --- 인스타그램 (Meta 앱 > Instagram Graph API, 프로페셔널 계정 필요) ---
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- 유튜브 (Google Cloud > YouTube Data API v3, OAuth) ---
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
